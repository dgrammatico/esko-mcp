{
  "name": "esko-webcenter-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server for Esko WebCenter (Claude Desktop extension)",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=server/index.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "mock": "node mock/server.mjs",
    "test": "node test/run.mjs",
    "package": "npm run build && node scripts/pack.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.12.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "@anthropic-ai/mcpb": "2.1.2"
  },
  "private": true
}